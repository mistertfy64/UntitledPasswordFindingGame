<tr>
  <td class="monospaced"><%=submission._id || "???"%></td>
  <td>
    <a href="/administrator/submissions/problem/<%=submission.problem?.problemID%>"><%=submission.problem?.problemID || "???"%></a>
    <br>
    <a class="smaller-text" href="/problem/<%=submission.problem?.problemID%>">view statement</a>
  </td>
  <td>
    <a href="/administrator/submissions/username/<%=submission.user?.username%>"><%=submission.user?.username || "???"%></a>
  </td>
  <td class="monospaced"><%=submission.answer|| "???"%></td>
  <td><%=submission.timestamp.toISOString()|| "???"%></td>
  <% if (submission.verdict === "correct answer") { %>
  <td><span class="answer--correct">CORRECT ANSWER</span></td>
  <% } else if (submission.verdict === "wrong answer"){ %>
  <td><span class="answer--wrong">WRONG ANSWER</span></td>
  <%} else { %>
  <td><span class="answer--ignored">IGNORED</span></td>
  <% }%>
</tr>
